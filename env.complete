# loggair: every setting has an environment variable (env > config files > defaults), plus switches that exist only as variables

# -- Settings (docs/configuration.md; the same keys are in loggair.example.yaml)
# LOGGAIR_DIR=./logs   folder the log files are written to
# LOGGAIR_SCRIPT_NAME=   name of the script, used in the log file names; empty = detected from argv (docs/configuration.md)
# LOGGAIR_FILE_LEVEL=DEBUG   TRACE | TRAIL | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL — lowest level the file sink records
# LOGGAIR_CONSOLE_LEVEL=INFO   TRACE | TRAIL | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL — lowest level the console shows
# LOGGAIR_ROTATION_ON_STARTUP=true   true | false — start a new log file at every start
# LOGGAIR_RETENTION=5   number of rotated log files kept
# LOGGAIR_COMPRESSION=   gz | zip — compression of rotated files; empty = none (docs/configuration.md)
# LOGGAIR_ROTATION=   loguru rotation rule, e.g. "100 MB"; empty = none
# LOGGAIR_ENQUEUE=false   true | false — write through a multiprocessing queue (docs/operations.md)
# LOGGAIR_SERIALIZE=false   true | false — write JSON lines
# LOGGAIR_CONSOLE_FORMAT=   loguru format string of the console sink; empty = built-in format
# LOGGAIR_FILE_FORMAT=   loguru format string of the file sink; empty = built-in format
# LOGGAIR_RELOAD_SIGNAL=   signal name (e.g. SIGUSR1) that re-reads the configuration; empty = none
# LOGGAIR_DEBUG_SIGNAL=   signal name (e.g. SIGUSR2) that toggles debug output; empty = none
# LOGGAIR_ALERT_LEVEL=ERROR   lowest level that triggers alerts
# LOGGAIR_ALERT_THROTTLE=60   seconds between alert deliveries; 0 delivers every batch
# LOGGAIR_ALERT_URLS=   comma-separated alert webhook URLs (a secret — keep it out of git)
# LOGGAIR_WORKER_FILES=false   true | false — each worker process writes its own file
# LOGGAIR_INTERCEPT=full   full | coexist | off — how standard-library logging is taken over (docs/operations.md)
# LOGGAIR_INTERCEPT_EXCLUDE=   comma-separated logger names that are not intercepted
# LOGGAIR_CAPTURE_WARNINGS=true   true | false — route warnings.warn through the logger

# -- Switches that exist only as variables (docs/configuration.md)
# LOGGAIR_EAGER_ENQUEUE=false   true | false — with enqueue, allocate the queue at configure time instead of at the first child process (docs/operations.md)
# LOGGAIR_DISABLE_LOGGING=   1 switches logging off in every process (docs/configuration.md)
# LOGGAIR_DISABLE_MULTIPROCESS_LOGGING=   1 switches logging off in child processes only
# NO_COLOR=   any non-empty value forces plain console output (docs/configuration.md)

# not for .env: RANK SLURM_PROCID OMPI_COMM_WORLD_RANK PMI_RANK PMIX_RANK MV2_COMM_WORLD_RANK LOCAL_RANK NODE_RANK GROUP_RANK LOCAL_WORLD_SIZE — set by the distributed launcher (torchrun, SLURM, MPI) to tell each process its rank
# not for .env: XDG_CONFIG_HOME — set by the desktop session; where the user-level loggair.yaml is looked up
